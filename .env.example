# Optional controlled AI drafting for Meeting Studio and Block 2 insights.
# Never commit a real key. Configure either Gemini or an OpenAI-compatible endpoint.
CLARITY_AI_PROVIDER=openai_compatible
CLARITY_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
CLARITY_OPENAI_COMPATIBLE_API_KEY=
CLARITY_OPENAI_COMPATIBLE_MODEL=gpt-4.1-mini

# Optional durable Task 3 state. Leave blank to use local JSON adapters offline.
DATABASE_URL=

# Shared bearer token for every POST route in a hosted demo. Leave blank only for local development.
CLARITY_API_TOKEN=

# Hosted resets are disabled by default. Set only for an isolated throwaway demo environment.
CLARITY_ALLOW_DEMO_RESET=false

# Override only when the synthetic CSV/JSON files live elsewhere.
CLARITY_DATA_DIR=

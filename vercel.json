{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd clarity/frontend && npm run build",
  "installCommand": "cd clarity/frontend && npm install && cd ../.. && pip install -r requirements.txt",
  "outputDirectory": "clarity/frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
